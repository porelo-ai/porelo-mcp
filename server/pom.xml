<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.fuin.porelo</groupId>
        <artifactId>porelo-mcp-root</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>porelo-mcp</artifactId>
    <name>Porelo MCP Server</name>
    <description>Offers every method of the daemon's contract as an MCP tool</description>
    <properties>
        <!-- 0.5.1 on: Json.parseDecimals, so a number passes through exactly as it came. -->
        <porelo-wire.version>0.5.1-SNAPSHOT</porelo-wire.version>
        <!-- The version without -SNAPSHOT, as the packages name it; check-package-version holds both packages to the
             project's version, so a value left behind here fails the build. -->
        <package.version>0.1.0</package.version>
        <!-- Named as porelo names its snapshots; CI sets the run and clears the local suffix. -->
        <porelo.snapshot.run>0</porelo.snapshot.run>
        <porelo.snapshot.suffix>+local.${maven.build.timestamp}</porelo.snapshot.suffix>
        <!-- Both packages' version; a tag's build writes the release here. The RPM's release is always 1. -->
        <deb.version>${package.version}~snapshot.${porelo.snapshot.run}${porelo.snapshot.suffix}</deb.version>
        <!-- The newest glibc and zlib symbol versions the native executable needs, which the DEB declares and
             check-linkage holds to the executable; rpmbuild reads the RPM's from the executable itself. -->
        <mcp.glibc.floor>2.34</mcp.glibc.floor>
        <mcp.zlib.floor>1.2.2</mcp.zlib.floor>
        <!-- The oldest system supported, Debian 13's glibc, as porelo's packages name it: a floor above it is refused. -->
        <mcp.glibc.ceiling>2.41</mcp.glibc.ceiling>
        <package.doc>/usr/share/doc/porelo-mcp</package.doc>
        <!-- What the integration tests run under -Pnative. -->
        <mcp.executable>${project.build.directory}/porelo-mcp</mcp.executable>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.fuin.porelo</groupId>
            <artifactId>porelo-wire</artifactId>
            <version>${porelo-wire.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <resources>
            <!-- Only what must carry a build value is filtered, so nothing else loses a ${...} it means literally. -->
            <resource>
                <directory>src/main/resources-filtered</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!-- The installed program is a native executable, so it needs no Java where it runs. -->
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <extensions>true</extensions>
                        <configuration>
                            <imageName>porelo-mcp</imageName>
                            <mainClass>org.fuin.porelo.mcp.Main</mainClass>
                            <buildArgs>
                                <!-- The baseline every x86-64 CPU has, as every Porelo executable: the default
                                     would ask for AVX2 and refuse to start on an older machine. -->
                                <buildArg>-march=x86-64</buildArg>
                            </buildArgs>
                        </configuration>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- The bill of what the executable is built from, shipped beside it. -->
                    <plugin>
                        <groupId>org.cyclonedx</groupId>
                        <artifactId>cyclonedx-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals>
                                    <goal>makeBom</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <outputFormat>json</outputFormat>
                            <outputName>sbom.cdx</outputName>
                            <includeTestScope>false</includeTestScope>
                            <!-- The bill goes into the packages; nothing goes to Central, which the plugin
                                 would otherwise take as a reason to make none. -->
                            <skipNotDeployed>false</skipNotDeployed>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.vafer</groupId>
                        <artifactId>jdeb</artifactId>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals>
                                    <goal>jdeb</goal>
                                </goals>
                                <configuration>
                                    <deb>${project.build.directory}/porelo-mcp_${deb.version}_amd64.deb</deb>
                                    <snapshotExpand>false</snapshotExpand>
                                    <dataSet>
                                        <data>
                                            <src>${mcp.executable}</src>
                                            <type>file</type>
                                            <mapper>
                                                <type>perm</type>
                                                <prefix>/usr/bin</prefix>
                                                <user>root</user>
                                                <group>root</group>
                                                <filemode>755</filemode>
                                            </mapper>
                                        </data>
                                        <data>
                                            <src>${project.build.directory}/sbom.cdx.json</src>
                                            <type>file</type>
                                            <mapper>
                                                <type>perm</type>
                                                <prefix>${package.doc}</prefix>
                                                <user>root</user>
                                                <group>root</group>
                                                <filemode>644</filemode>
                                            </mapper>
                                        </data>
                                        <data>
                                            <src>${project.basedir}/../LICENSE</src>
                                            <dst>copyright</dst>
                                            <type>file</type>
                                            <mapper>
                                                <type>perm</type>
                                                <prefix>${package.doc}</prefix>
                                                <user>root</user>
                                                <group>root</group>
                                                <filemode>644</filemode>
                                            </mapper>
                                        </data>
                                    </dataSet>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>rpm-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>porelo-mcp-rpm</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>attached-rpm</goal>
                                </goals>
                                <configuration>
                                    <name>porelo-mcp</name>
                                    <version>${deb.version}</version>
                                    <release>1</release>
                                    <!-- Beside the DEB, where check-package-version reads both. -->
                                    <copyTo>${project.build.directory}/porelo-mcp-${deb.version}-1.x86_64.rpm</copyTo>
                                    <license>GPL-3.0-or-later</license>
                                    <group>Development/Tools</group>
                                    <summary>Porelo's daemon contract as MCP tools</summary>
                                    <description>Offers every method of the Porelo daemon's Tasks1 interface as an MCP tool: over HTTP on a task's own Unix socket when the daemon starts it, and over stdio for a person's own MCP client.</description>
                                    <url>https://github.com/porelo-ai/porelo-mcp</url>
                                    <needarch>x86_64</needarch>
                                    <!-- No requires of its own: rpmbuild reads every library and symbol version from the
                                         executable itself. -->
                                    <defaultUsername>root</defaultUsername>
                                    <defaultGroupname>root</defaultGroupname>
                                    <mappings>
                                        <mapping>
                                            <directory>/usr/bin</directory>
                                            <directoryIncluded>false</directoryIncluded>
                                            <filemode>755</filemode>
                                            <sources>
                                                <source>
                                                    <location>${mcp.executable}</location>
                                                </source>
                                            </sources>
                                        </mapping>
                                        <!-- The directory on its own: a mapping with files gives its directory the files' mode. -->
                                        <mapping>
                                            <directory>${package.doc}</directory>
                                            <filemode>755</filemode>
                                        </mapping>
                                        <mapping>
                                            <directory>${package.doc}</directory>
                                            <directoryIncluded>false</directoryIncluded>
                                            <filemode>644</filemode>
                                            <documentation>true</documentation>
                                            <sources>
                                                <source>
                                                    <location>${project.build.directory}/sbom.cdx.json</location>
                                                </source>
                                                <source>
                                                    <location>${project.basedir}/../LICENSE</location>
                                                </source>
                                            </sources>
                                        </mapping>
                                    </mappings>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- The integration tests run the executable from the packages, as a machine runs it. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <systemPropertyVariables>
                                <mcp.executable>${mcp.executable}</mcp.executable>
                                <mcp.version>${project.version}</mcp.version>
                                <mcp.glibc.floor>${mcp.glibc.floor}</mcp.glibc.floor>
                                <mcp.zlib.floor>${mcp.zlib.floor}</mcp.zlib.floor>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                    <!-- The shared checks of porelo-release, on what this build packed. -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>check-linkage</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/java</executable>
                                    <includeProjectDependencies>false</includeProjectDependencies>
                                    <includePluginDependencies>true</includePluginDependencies>
                                    <executableDependency>
                                        <groupId>org.fuin.porelo</groupId>
                                        <artifactId>porelo-release</artifactId>
                                    </executableDependency>
                                    <commandlineArgs>-classpath %classpath org.fuin.porelo.release.Main check-linkage --declare libc.so.6=GLIBC:${mcp.glibc.floor} --declare libz.so.1=ZLIB:${mcp.zlib.floor} --ceiling GLIBC=${mcp.glibc.ceiling} ${mcp.executable}</commandlineArgs>
                                </configuration>
                            </execution>
                            <execution>
                                <id>check-package-version</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/java</executable>
                                    <includeProjectDependencies>false</includeProjectDependencies>
                                    <includePluginDependencies>true</includePluginDependencies>
                                    <executableDependency>
                                        <groupId>org.fuin.porelo</groupId>
                                        <artifactId>porelo-release</artifactId>
                                    </executableDependency>
                                    <!-- The run with its local suffix, which CI leaves empty: a local build's packages say it too. -->
                                    <commandlineArgs>-classpath %classpath org.fuin.porelo.release.Main check-package-version porelo-mcp ${project.version} ${porelo.snapshot.run}${porelo.snapshot.suffix} ${project.build.directory}</commandlineArgs>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
